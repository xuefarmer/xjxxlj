# ========== API 与模型（qwen_agent.py）==========
# Master 纯文本推理模型
# local_hf: use local Qwen3-8B for master reasoning.
# api: use MASTER_API_* below for master reasoning.
MASTER_BACKEND=local_hf
LOCAL_MASTER_MODEL_PATH=/media/data6/xuejj/Qwen3-8B
LOCAL_MASTER_MAX_NEW_TOKENS=8192
LOCAL_MASTER_TEMPERATURE=0.2
LOCAL_MASTER_TOP_P=0.95
LOCAL_MASTER_TOP_K=20
# Optional fixed device. Examples: cuda:0, cuda:1, cpu. If set, it overrides LOCAL_MASTER_DEVICE_MAP.
LOCAL_MASTER_DEVICE=
LOCAL_MASTER_DEVICE_MAP=auto
LOCAL_MASTER_TORCH_DTYPE=auto
LOCAL_MASTER_ENABLE_THINKING=false

# Master API fallback, only used when MASTER_BACKEND=api.
MASTER_API_BASE_URL=http://example-master-api.example.com/v1/chat/completions
MASTER_API_KEY=your-api-key
MASTER_MODEL_NAME=your-master-model
MASTER_MAX_TOKENS=8192
MASTER_TEMPERATURE=0.5

# Tool / 视觉观察模型
# api: use TOOL_API_* below for visual observation.
# local_qwenvl: load local HuggingFace QwenVL directly.
TOOL_BACKEND=api
LOCAL_TOOL_MODEL_PATH=/media/data6/xuejj/Qwen
LOCAL_TOOL_MAX_NEW_TOKENS=8192
LOCAL_TOOL_TEMPERATURE=0.2
LOCAL_TOOL_TOP_P=0.95
LOCAL_TOOL_TOP_K=20
LOCAL_TOOL_DEVICE=
LOCAL_TOOL_DEVICE_MAP=auto
LOCAL_TOOL_TORCH_DTYPE=auto

TOOL_API_BASE_URL=http://example-tool-api.example.com/v1/chat/completions
TOOL_API_KEY=your-api-key
TOOL_MODEL_NAME=your-tool-model
TOOL_MAX_TOKENS=8192
TOOL_TEMPERATURE=0.5

# Diagnosis / error attribution agent. This remains API-based.
# Defaults to MASTER_API_* if left unset.
DIAGNOSIS_API_BASE_URL=http://example-diagnosis-api.example.com/v1/chat/completions
DIAGNOSIS_API_KEY=your-diagnosis-api-key
DIAGNOSIS_MODEL_NAME=your-diagnosis-model
DIAGNOSIS_MAX_TOKENS=8192
DIAGNOSIS_TEMPERATURE=0.2

# ========== 视频路径（run_*_agent 脚本）==========
# 本地视频缓存根目录，下含子目录 cooking / movies / behavior / assembly 等
LOCAL_VIDEO_ROOT=/path/to/your/local/video/cache
# 远程视频 base URL，脚本会拼接子路径如 /youcook2/xxx.mp4
REMOTE_VIDEO_BASE_URL=https://your-remote-video-server.com

# UAV 任务专用数据集根目录
UAV_DATA_DIR=/path/to/your/uav/dataset

# ========== 评分 API（仅 run_open_agent.py）==========
SCORING_API_BASE_URL=https://your-scoring-api.com/v1:generateContent
SCORING_API_KEY=your-scoring-api-key
SCORING_MODEL_NAME=your-scoring-model
SCORING_MAX_TOKENS=16384
