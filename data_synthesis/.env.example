# Copy this file to .env and fill in your settings. Do not commit .env to version control.

# ---- LLM Provider selection ----
# Set to "openai" for OpenAI-compatible API, or leave unset / "gemini" for Gemini.
# LLM_PROVIDER=gemini

# ---- Gemini settings (used when LLM_PROVIDER is not "openai") ----
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_ENDPOINT=https://example.googleapis.com/v1:generateContent
# GEMINI_MODEL=gemini-3-flash-preview

# ---- OpenAI settings (used when LLM_PROVIDER=openai) ----
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o


